<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<TargetFramework>netstandard2.1</TargetFramework>
		<LangVersion>latest</LangVersion>

		<GenerateAssemblyInfo>false</GenerateAssemblyInfo>
		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>
		<Nullable>disable</Nullable>
	</PropertyGroup>

	<PropertyGroup>
		<AssemblyName>lammas123.CrabDevPreloader</AssemblyName>
		<Product>CrabDevPreloader</Product>
		<Version>1.4.0</Version>

		<AutoLaunchDir Condition="'$(AutoLaunchDir)' == ''">lammas123-CrabDevKit</AutoLaunchDir>
		<SteamPath Condition="'$(SteamPath)' == ''">S:/Steam/steam.exe</SteamPath>

		<ProfileDir Condition="'$(ProfileDir)' == ''">C:/Users/lamma/AppData/Roaming/r2modmanPlus-local/CrabGame/profiles/modded</ProfileDir>
	</PropertyGroup>

	<!-- Configurations -->
	<PropertyGroup>
		<Configurations>Debug;Release</Configurations>
	</PropertyGroup>

	<PropertyGroup Condition="'$(Configuration)' == 'Debug'">
		<DebugSymbols>true</DebugSymbols>
		<DebugType>embedded</DebugType>

		<!-- Trim the path to just include the project in stack traces -->
		<PathMap>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)'))=./</PathMap>

		<AutoLaunch>true</AutoLaunch>
	</PropertyGroup>

	<PropertyGroup Condition="'$(Configuration)' == 'Release'">
		<DebugSymbols>false</DebugSymbols>
		<DebugType>none</DebugType>

		<!-- Trim the path to just include the project in stack traces -->
		<PathMap>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)'))=./</PathMap>

		<AutoLaunch>false</AutoLaunch>
	</PropertyGroup>


	<!-- Building -->
	<Target Name="ClearReferenceCopyLocalPaths" AfterTargets="ResolveAssemblyReferences">
		<ItemGroup>
			<ReferenceCopyLocalPaths Remove="@(ReferenceCopyLocalPaths)" />
		</ItemGroup>
	</Target>

	<Target Name="PostBuild" AfterTargets="PostBuildEvent" Condition="'$(AutoLaunch)' == 'true'">
		<MakeDir Directories="$(ProfileDir)/BepInEx/patchers/$(AutoLaunchDir)" Condition="!Exists('$(ProfileDir)/BepInEx/patchers/$(AutoLaunchDir)')" />

		<Copy SourceFiles="$(OutDir)$(AssemblyName).dll"
			  DestinationFiles="$(ProfileDir)/BepInEx/patchers/$(AutoLaunchDir)/$(AssemblyName).dll"
			  SkipUnchangedFiles="true" />

		<Exec Command="$(SteamPath) steam://rungameid/1782210" Condition="Exists('$(SteamPath)')" />
		<Warning Condition="!Exists('$(SteamPath)')" Text="The Steam path $(SteamPath) does not exist." />
	</Target>

	<Target Name="Thunderstore" AfterTargets="PostBuildEvent" Condition="'$(Configuration)' == 'Release'">
		<Copy SourceFiles="$(OutDir)$(AssemblyName).dll"
		      DestinationFiles="$(MSBuildProjectDirectory)/../CrabDevKit/Thunderstore/CrabDevKit/BepInEx/patchers/$(AssemblyName).dll"
			  Condition="Exists('$(MSBuildProjectDirectory)/../CrabDevKit/Thunderstore/CrabDevKit/BepInEx/patchers')"
			  SkipUnchangedFiles="true" />

		<Warning Condition="!Exists('$(MSBuildProjectDirectory)/../CrabDevKit/Thunderstore/CrabDevKit/BepInEx/patchers')" Text="The Thunderstore directory $(MSBuildProjectDirectory)/../CrabDevKit/Thunderstore/CrabDevKit/BepInEx/patchers does not exist." />
	</Target>


	<!-- Dependencies -->
	<ItemGroup>
		<PackageReference Include="Mono.Cecil" Version="0.11.4" />
		<PackageReference Include="MonoMod" Version="22.7.31.1" />

		<PackageReference Include="BepInEx.PluginInfoProps" Version="2.1.0" />
	</ItemGroup>

	<ItemGroup>
		<!-- BepInEx Assemblies -->
		<Reference Include="0Harmony">
			<HintPath>$(ProfileDir)/BepInEx/core/0Harmony.dll</HintPath>
		</Reference>
		<Reference Include="BepInEx.IL2CPP">
			<HintPath>$(ProfileDir)/BepInEx/core/BepInEx.IL2CPP.dll</HintPath>
		</Reference>
		<Reference Include="BepInEx.Core">
			<HintPath>$(ProfileDir)/BepInEx/core/BepInEx.Core.dll</HintPath>
		</Reference>
		<Reference Include="BepInEx.Preloader.Core">
			<HintPath>$(ProfileDir)/BepInEx/core/BepInEx.Preloader.Core.dll</HintPath>
		</Reference>
	</ItemGroup>
</Project>